{
  "name": "file-share-app",
  "version": "1.0.0",
  "description": "A secure file sharing application built with MERN stack",
  "main": "index.js",
  "scripts": {
    "install-backend": "cd backend && npm install",
    "install-frontend": "cd frontend && npm install",
    "install-all": "npm run install-backend && npm run install-frontend",
    "dev-backend": "cd backend && npm run dev",
    "dev-frontend": "cd frontend && npm start",
    "build-frontend": "cd frontend && npm run build",
    "start-backend": "cd backend && npm start",
    "test-backend": "cd backend && npm test",
    "test-frontend": "cd frontend && npm test",
    "clean": "rm -rf backend/node_modules frontend/node_modules backend/uploads/*",
    "setup": "npm run install-all && echo 'Setup complete! Copy .env files and configure them.'"
  },
  "keywords": [
    "file-sharing",
    "mern",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "upload",
    "download"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/file-share-app.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/file-share-app/issues"
  },
  "homepage": "https://github.com/yourusername/file-share-app#readme"
}
