# Database
MONGODB_URI=mongodb://localhost:27017/file-share-app
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/file-share-app

# Server
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=your-session-secret-here
ENABLE_HSTS=false
ENABLE_AV_SCAN=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMSCAN_PATH=

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,video/mp4,video/avi

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:3000
